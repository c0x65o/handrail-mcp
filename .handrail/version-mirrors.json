{
  "schema_version": 1,
  "source": "package.json",
  "mirrors": [
    {
      "file": "src/version.js",
      "format": "text_templates",
      "templates": [
        "export const CONNECTOR_VERSION = \"{{version}}\";"
      ]
    },
    {
      "file": "RELEASE.json",
      "format": "text_templates",
      "templates": [
        "\"connector_version\": \"{{version}}\"",
        "\"immutable_release_tag\": \"v{{version}}\"",
        "\"artifact\": \"handrail-mcp-{{version}}.tgz\""
      ]
    },
    {
      "file": "README.md",
      "format": "text_templates",
      "templates": [
        "Current connector version: `{{version}}`."
      ]
    }
  ]
}
